<Window x:Class="WheelPad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FORZA HORIZON // COMPANION COCKPIT" 
        Icon="app_icon.ico"
        Height="680" Width="1040"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#06090F"
        Foreground="#FFFFFF"
        FontFamily="./Assets/Fonts/#Chakra Petch, Bahnschrift, Segoe UI, sans-serif"
        ResizeMode="CanResize">
    
    <Window.Resources>
        <!-- Authentic Forza Slanted Ribbon Transform -->
        <SkewTransform x:Key="ForzaSlant" AngleX="-12"/>

        <!-- Cockpit Smoked Glass Card Style -->
        <Style x:Key="CockpitCard" TargetType="Border">
            <Setter Property="Background" Value="#E60A1018"/>
            <Setter Property="BorderBrush" Value="#223246"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Metric Header Label -->
        <Style x:Key="MetricHeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8EA6C2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontFamily" Value="./Assets/Fonts/#Chakra Petch, Bahnschrift, Segoe UI"/>
        </Style>

        <!-- Neon Volt Action Button -->
        <Style x:Key="VoltButton" TargetType="Button">
            <Setter Property="Background" Value="#101722"/>
            <Setter Property="Foreground" Value="#CCFF00"/>
            <Setter Property="BorderBrush" Value="#CCFF00"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CCFF00"/>
                                <Setter Property="Foreground" Value="#06090F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Tool Button -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#121B27"/>
            <Setter Property="Foreground" Value="#8EA6C2"/>
            <Setter Property="BorderBrush" Value="#223246"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ghostBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ghostBorder" Property="BorderBrush" Value="#CCFF00"/>
                                <Setter Property="Foreground" Value="#CCFF00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 0. Ambient Cinematic Forza Horizon Background (Authentic Night Drift Car Atmosphere) -->
        <Grid x:Name="GridAmbientBg">
            <Image x:Name="ImgAmbientBg" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.42"/>
            
            <!-- High-End Cinematic Vignette & Ambient Radial Lighting -->
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.85" RadiusY="0.85">
                        <GradientStop Color="#2506090F" Offset="0.0"/>
                        <GradientStop Color="#8006090F" Offset="0.50"/>
                        <GradientStop Color="#E606090F" Offset="0.82"/>
                        <GradientStop Color="#F806090F" Offset="1.0"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Subtle Horizontal Cyber / Motorsport Grid Overlay -->
            <Rectangle Opacity="0.04">
                <Rectangle.Fill>
                    <DrawingBrush Viewport="0,0,10,10" ViewportUnits="Absolute" TileMode="Tile">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#FFFFFF">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,10,1"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Main Foreground Layout -->
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0. Header Bar -->
                <RowDefinition Height="Auto"/> <!-- 1. Update Notification Banner -->
                <RowDefinition Height="*"/>    <!-- 2. Cockpit Dashboard Columns -->
                <RowDefinition Height="Auto"/> <!-- 3. Bottom Status Deck -->
            </Grid.RowDefinitions>

            <!-- 1. Top Header: Forza Horizon Festival Brand Bar -->
            <Border Grid.Row="0" Margin="0,0,0,14" Background="#E60A1018" BorderBrush="#223246" BorderThickness="1.5" CornerRadius="6" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Slanted Horizon Badge + Suite Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Slanted Neon Volt Badge -->
                        <Border Background="#CCFF00" CornerRadius="4" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="FH" FontSize="14" FontWeight="Black" Foreground="#06090F"/>
                                <TextBlock Text="6" FontSize="14" FontWeight="Black" Foreground="#06090F" Margin="1,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="FORZA HORIZON" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock Text="// COMPANION SUITE" FontSize="13" FontWeight="Black" Foreground="#CCFF00" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Border Background="#1C2738" BorderBrush="#2E4059" BorderThickness="1" CornerRadius="3" Margin="12,0,0,0" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="120Hz FASTSTREAM" FontSize="9" FontWeight="Black" Foreground="#00E5FF"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Virtual Xbox 360 Hardware Emulation via ViGEmBus · Direct UDP FastStream Engine" FontSize="10" Foreground="#8EA6C2" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Controller Connection Pill -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="PillViGEm" Background="#0C1420" BorderBrush="#223246" BorderThickness="1.5" CornerRadius="5" Padding="12,7" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#CCFF00" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtControllerStatus" Text="STEAM / ViGEmBUS ACTIVE" FontSize="10" FontWeight="Black" Foreground="#CCFF00"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1.5. Dynamic In-App Auto-Update Banner -->
            <Border Grid.Row="1" x:Name="BannerUpdate" Background="#162409" BorderBrush="#CCFF00" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ UPDATE AVAILABLE:" FontWeight="Black" FontSize="11" Foreground="#CCFF00" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtUpdateTitle" Text="v1.2.0 is now live" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtUpdateChangelog" Text="Changelog: Dual Analog Stick ViGEmBus axes and 120Hz FastStream extended pipeline." FontSize="10" Foreground="#A0B0C0" Margin="0,2,0,0"/>
                        <ProgressBar x:Name="ProgUpdate" Height="4" Background="#080C12" Foreground="#CCFF00" BorderThickness="0" Margin="0,6,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button x:Name="BtnApplyUpdate" Style="{StaticResource VoltButton}" Content="UPDATE NOW" Padding="12,6" Click="BtnApplyUpdate_Click"/>
                        <Button x:Name="BtnDismissUpdate" Background="Transparent" Foreground="#7E94AD" BorderThickness="0" Content="✕" Margin="8,0,0,0" FontSize="12" Cursor="Hand" Click="BtnDismissUpdate_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Main Cockpit Grid -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="1.35*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: The Paddock (Mobile Pairing + Game Engine) -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Card 1: Paddock // Mobile Pairing -->
                    <Border Grid.Row="0" Style="{StaticResource CockpitCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Card Header -->
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="12" Background="#CCFF00" Margin="0,0,8,0"/>
                                    <TextBlock Text="PADDOCK // MOBILE CONTROLLER SYNC" Style="{StaticResource MetricHeaderLabel}"/>
                                </StackPanel>
                                <Border Background="#162410" BorderBrush="#CCFF00" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock Text="BROADCAST ACTIVE" Foreground="#CCFF00" FontSize="8" FontWeight="Black"/>
                                </Border>
                            </Grid>

                            <!-- QR Code & Connection Info -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- QR Box with Neon Corner Accents -->
                                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CCFF00" BorderThickness="2" CornerRadius="6" Padding="6" Margin="0,0,14,0">
                                    <Image x:Name="ImgQrCode" Width="102" Height="102" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>

                                <!-- Host Connection Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="PC HOST IP ADDRESS:" FontSize="10" Foreground="#8EA6C2" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtLocalIp" Text="127.0.0.1" FontSize="19" FontWeight="Black" Foreground="#CCFF00" Margin="0,2,0,6"/>
                                    <TextBlock Text="Scan with the Android app in-game scanner to pair instantly." FontSize="10" Foreground="#A2B6CC" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <Border Background="#0C1420" BorderBrush="#1E2C3E" BorderThickness="1" CornerRadius="3" Padding="8,4">
                                        <TextBlock Text="PORTS: UDP 4242 (Inputs) · TCP 4243 (Sync)" FontSize="9" FontWeight="Black" Foreground="#00E5FF"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#1C2A3A" Margin="0,0,0,10"/>

                            <!-- Mobile Controller Live Status -->
                            <Grid>
                                <TextBlock Text="MOBILE CONTROLLER:" FontSize="10" Foreground="#8EA6C2" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtPhoneStatus" Text="Waiting for connection..." FontWeight="Black" FontSize="11" Foreground="#FFCC00" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Forza Horizon Engine Link -->
                    <Border Grid.Row="1" Style="{StaticResource CockpitCard}">
                        <StackPanel VerticalAlignment="Center">
                            <!-- Card Header -->
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="12" Background="#00E5FF" Margin="0,0,8,0"/>
                                    <TextBlock Text="FORZA ENGINE TELEMETRY LINK" Style="{StaticResource MetricHeaderLabel}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Supported: FH6 · FH5 · FH4 · FH3 · Forza Motorsport" FontSize="10" Foreground="#8EA6C2" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <!-- Detected Game HUD Status -->
                            <Border Background="#0A1018" BorderBrush="#1E2C3E" BorderThickness="1.5" CornerRadius="4" Padding="14,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="DETECTED TITLE:" FontSize="10" Foreground="#8EA6C2" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtGameStatus" Text="Scanning for game..." FontWeight="Black" FontSize="11" Foreground="#8EA6C2" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="PROCESS ID (PID):" FontSize="10" Foreground="#8EA6C2" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtProcessId" Text="--" FontWeight="Bold" FontSize="11" Foreground="#00E5FF" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Launcher Status Grid -->
                            <Border Background="#0A1018" BorderBrush="#1E2C3E" BorderThickness="1.5" CornerRadius="4" Padding="10,8" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="PLATFORM SUPPORT &amp; COMPATIBILITY:" FontSize="9" FontWeight="Black" Foreground="#8EA6C2" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtSteamStatus" Grid.Column="0" Text="STEAM: READY" FontSize="9" FontWeight="Bold" Foreground="#CCFF00"/>
                                        <TextBlock x:Name="TxtXboxStatus" Grid.Column="1" Text="XBOX: READY" FontSize="9" FontWeight="Bold" Foreground="#CCFF00" TextAlignment="Center"/>
                                        <TextBlock x:Name="TxtEpicStatus" Grid.Column="2" Text="EPIC: READY" FontSize="9" FontWeight="Bold" Foreground="#CCFF00" TextAlignment="Right"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtLauncherNote" Text="Compatible across Steam, Xbox Game Pass, and Epic Games Store" FontSize="9" Foreground="#6C7F94" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Right Column: Live Sim-Rig Telemetry Cockpit (The Star Feature!) -->
                <Border Grid.Column="1" Style="{StaticResource CockpitCard}" Margin="12,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header & Live Packet Rate -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="3" Height="12" Background="#FF007F" Margin="0,0,8,0"/>
                                <TextBlock Text="LIVE TELEMETRY // STEERING &amp; PEDALS" Style="{StaticResource MetricHeaderLabel}" Margin="0"/>
                            </StackPanel>
                            <Border Background="#0C1420" BorderBrush="#223246" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#00E5FF" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtPacketRate" Text="0 PACKETS/SEC" Foreground="#00E5FF" FontSize="10" FontWeight="Black"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Telemetry Visuals: Steering Wheel + Pedals -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. Live Rotating Forza Motorsport Steering Wheel -->
                            <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Canvas x:Name="CanvasWheel" Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Rotating Wheel Assembly -->
                                    <Grid x:Name="WheelContainer" Width="200" Height="200" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="WheelRotation" Angle="0"/>
                                        </Grid.RenderTransform>

                                        <!-- Outer Gunmetal Racing Rim -->
                                        <Ellipse Stroke="#FFFFFF" StrokeThickness="3.5" Width="192" Height="192" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <!-- Inner Chamfer Ring -->
                                        <Ellipse Stroke="#35FFFFFF" StrokeThickness="1.5" Width="162" Height="162" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- 12 O'Clock Volt Lime Center Alignment Notch -->
                                        <Rectangle Fill="#CCFF00" Width="8" Height="20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"/>

                                        <!-- Perforated Sport Grips (9 and 3 o'clock) -->
                                        <Rectangle Fill="#25FFFFFF" Width="20" Height="48" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" RadiusX="4" RadiusY="4"/>
                                        <Rectangle Fill="#25FFFFFF" Width="20" Height="48" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" RadiusX="4" RadiusY="4"/>

                                        <!-- 9 o'clock spoke -->
                                        <Rectangle Fill="#70FFFFFF" Width="66" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        <!-- 3 o'clock spoke -->
                                        <Rectangle Fill="#70FFFFFF" Width="66" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <!-- 6 o'clock spoke -->
                                        <Rectangle Fill="#70FFFFFF" Width="16" Height="62" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"/>

                                        <!-- Central Hub with FH Festival Insignia -->
                                        <Ellipse Fill="#0A1018" Stroke="#CCFF00" StrokeThickness="2.5" Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="FH" FontSize="15" FontWeight="Black" Foreground="#CCFF00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Canvas>

                                <!-- Steering Readout -->
                                <Border Background="#0C1420" BorderBrush="#1E2C3E" BorderThickness="1" CornerRadius="4" Padding="12,5" HorizontalAlignment="Center" Margin="0,230,0,0">
                                    <TextBlock x:Name="TxtSteerVal" Text="STEERING: CENTER (0%)" FontSize="11" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- 2. Vertical GT3/F1 LED Style Pedal Meters -->
                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Brake LT Meter (Racing Magenta) -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <Border Background="#200010" BorderBrush="#FF007F" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,0,8" HorizontalAlignment="Center">
                                        <TextBlock Text="BRAKE (LT)" FontSize="9" FontWeight="Black" Foreground="#FF007F"/>
                                    </Border>
                                    
                                    <!-- Brake Meter Housing (220px) -->
                                    <Border Width="48" Height="220" Background="#080C14" BorderBrush="#FF007F" BorderThickness="1.5" CornerRadius="6" Padding="3">
                                        <Grid VerticalAlignment="Bottom">
                                            <Border x:Name="BarBrakeFill" Height="0" Background="#FF007F" CornerRadius="3"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="TxtBrakeVal" Text="0%" FontSize="14" FontWeight="Black" Foreground="#FF007F" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>

                                <!-- Throttle RT Meter (Electric Volt Lime) -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <Border Background="#162409" BorderBrush="#CCFF00" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,0,8" HorizontalAlignment="Center">
                                        <TextBlock Text="ACCEL (RT)" FontSize="9" FontWeight="Black" Foreground="#CCFF00"/>
                                    </Border>
                                    
                                    <!-- Throttle Meter Housing (220px) -->
                                    <Border Width="48" Height="220" Background="#080C14" BorderBrush="#CCFF00" BorderThickness="1.5" CornerRadius="6" Padding="3">
                                        <Grid VerticalAlignment="Bottom">
                                            <Border x:Name="BarThrottleFill" Height="0" Background="#CCFF00" CornerRadius="3"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="TxtThrottleVal" Text="0%" FontSize="14" FontWeight="Black" Foreground="#CCFF00" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. Bottom Command Strip -->
            <Border Grid.Row="3" Background="#E60A1018" BorderBrush="#223246" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,12,0,0">
                <Grid>
                    <TextBlock x:Name="TxtFooter" Text="Forza Horizon Companion running · ViGEmBus slot 1 mapped · FastStream active." FontSize="11" Foreground="#8EA6C2" VerticalAlignment="Center"/>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="CHECK FOR UPDATES" Margin="0,0,8,0" Click="BtnCheckUpdates_Click"/>
                        <Button Style="{StaticResource VoltButton}" Content="MINIMIZE TO TRAY" Click="BtnMinimizeTray_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
