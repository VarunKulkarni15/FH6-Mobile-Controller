<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>fh6-controller-windows</AssemblyName>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <AssemblyTitle>Forza Horizon Controller Companion</AssemblyTitle>
    <Product>Forza Horizon Controller Suite</Product>
    <Description>Sim racing hardware-level controller emulator and telemetry companion for Forza Horizon</Description>
    <Company>Varun Kulkarni</Company>
    <Copyright>Copyright ? 2026 Varun Kulkarni. All rights reserved.</Copyright>
    <Version>1.5.0</Version>
    <FileVersion>1.5.0.0</FileVersion>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app_icon.ico" />
    <None Update="app_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Images\*.*" />
    <None Update="Assets\Images\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WheelPad.Core\WheelPad.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="..\..\shared-protocol\default_profiles.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

</Project>
